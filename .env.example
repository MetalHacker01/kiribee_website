# Public site URL (used in metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://kiribee.com

# Resend API key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxx

# Verified sender on Resend (must be a verified domain — e.g. mail.kiribee.com)
RESEND_FROM=Kiribee <noreply@mail.kiribee.com>

# Where contact form messages are delivered
CONTACT_TO=kiribeecom@gmail.com

# Google reCAPTCHA v2 checkbox (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key
